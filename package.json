{
  "name": "geglo-browser",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Geglo Browser",
  "description": "Fast, dark-mode browser with built-in Geglo AI Chat and 10-color tab groups.",
  "author": "Geglo",
  "build": {
    "appId": "com.geglo.browser",
    "productName": "Geglo Browser",
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}